# NexusPoint provider-neutral configuration
# COPY to a local file outside Git. Never commit real credentials.

AE_ROOT=$HOME/Æ
NEXUSPOINT_ROOT=$HOME/NexusPoint
NEXUS_PRIVATE_ROOT=$HOME/Æ/private
NEXUS_CACHE_ROOT=$HOME/Æ/cache

# rclone remote names are local configuration, not secrets.
NEXUS_PROVIDER_ONEDRIVE_REMOTE=onedrive
NEXUS_PROVIDER_GOOGLE_REMOTE=gdrive
NEXUS_PROVIDER_APPLE_REMOTE=icloud

# Remote root may be changed to match the shared provider folder.
NEXUS_REMOTE_ROOT=NEXUSDRIVE/NexusPoint

# Sync scheduling is intentionally conservative.
NEXUS_SYNC_INTERVAL=300

# Optional private transport namespace. Leave empty until configured locally.
NEXUS_TAILSCALE_NAMESPACE=

# Optional local services; do not expose them to the public internet by default.
NEXUS_BIND_ADDRESS=127.0.0.1
NEXUS_HTTP_PORT=8787
